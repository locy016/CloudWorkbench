    {
      "id": "uk-public-health",
      "category": "health",
      "language": "en",
      "readerHosts": ["www.gov.uk"],
      "title": "英国卫生与社会保健资讯",
      "publisher": "英国卫生与社会保健部（DHSC）",
      "sourceUrl": "https://www.gov.uk/government/organisations/department-of-health-and-social-care",
      "endpoint": "https://www.gov.uk/search/news-and-communications.atom",
      "format": "atom",
      "query": { "organisations[]": "department-of-health-and-social-care" },
      "cacheSeconds": 120,
