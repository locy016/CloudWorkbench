{
  "sources": [
    {
      "id": "un-geneva-headlines",
      "language": "en",
      "readerHosts": ["www.ungeneva.org"],
      "title": "联合国日内瓦要闻",
      "publisher": "联合国日内瓦办事处（UN Geneva）",
      "sourceUrl": "https://www.ungeneva.org/en/news-media/rss",
      "endpoint": "https://www.ungeneva.org/en/news-media/press-items-list/rss.xml",
      "format": "rss",
      "category": "headlines",
      "cacheSeconds": 120,
      "limit": 30
    },
    {
      "id": "eu-commission-briefings",
      "language": "en",
      "readerHosts": ["ec.europa.eu"],
      "title": "欧盟委员会时事通报",
      "publisher": "欧盟委员会（European Commission）",
      "sourceUrl": "https://ec.europa.eu/commission/presscorner/home/en",
      "endpoint": "https://ec.europa.eu/commission/presscorner/api/rss",
      "format": "rss",
      "category": "current",
      "query": { "language": "en" },
      "cacheSeconds": 120,
      "limit": 30
    },
    {
      "id": "usgs-earthquakes",
      "title": "全球地震动态",
      "publisher": "美国地质调查局（USGS）",
      "sourceUrl": "https://earthquake.usgs.gov/earthquakes/feed/v1.0/geojson.php",
      "endpoint": "https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/2.5_{period}.geojson",
      "filters": [
        { "key": "period", "label": "时间范围", "options": [
          { "value": "hour", "label": "过去 1 小时" },
          { "value": "day", "label": "过去 24 小时" },
          { "value": "week", "label": "过去 7 天" }
        ]}
      ],
      "rows": "features",
      "updated": "metadata.generated",
      "fields": [
        { "key": "event", "label": "事件", "path": "properties.title" },
        { "key": "place", "label": "地点", "path": "properties.place" },
        { "key": "magnitude", "label": "震级", "path": "properties.mag" },
        { "key": "time", "label": "事件时间", "path": "properties.time", "format": "timestamp" }
      ],
      "limit": 50
    },
    {
      "id": "github-releases",
      "title": "开源项目发布动态",
      "publisher": "GitHub Releases",
      "sourceUrl": "https://docs.github.com/en/rest/releases/releases#list-releases",
      "endpoint": "https://api.github.com/repos/{project}/releases",
      "query": { "per_page": "10" },
      "filters": [
        { "key": "project", "label": "项目", "options": [
          { "value": "nodejs/node", "label": "Node.js" },
          { "value": "denoland/deno", "label": "Deno" }
        ]}
      ],
      "rows": "",
      "fields": [
        { "key": "release", "label": "发布名称", "path": "name" },
        { "key": "version", "label": "版本", "path": "tag_name" },
        { "key": "published-at", "label": "发布时间", "path": "published_at" }
      ],
      "limit": 10
    },
    {
      "id": "wto-trade-news",
      "language": "en",
      "readerHosts": ["www.wto.org"],
      "category": "trade",
      "title": "WTO 国际贸易新闻",
      "publisher": "WTO news",
      "sourceUrl": "https://www.wto.org/english/res_e/webcas_e/rss_e.htm",
      "endpoint": "https://www.wto.org/library/rss/latest_news_e.xml",
      "format": "rss",
      "cacheSeconds": 60,
      "limit": 60
    },
    {
