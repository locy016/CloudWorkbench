      "title": "英国就业与社会保障资讯",
      "publisher": "英国就业和养老金部（DWP）",
      "sourceUrl": "https://www.gov.uk/government/organisations/department-for-work-pensions",
      "endpoint": "https://www.gov.uk/search/news-and-communications.atom",
      "format": "atom",
      "query": { "organisations[]": "department-for-work-pensions" },
      "cacheSeconds": 120,
      "limit": 25
    },
    {
      "id": "historic-england-culture",
      "category": "humanities",
      "language": "en",
      "readerHosts": ["www.gov.uk", "historicengland.org.uk"],
