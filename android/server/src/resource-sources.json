    {
      "id": "nws-marine-alerts",
      "category": "logistics",
      "title": "海运气象警报",
      "publisher": "美国国家气象局（NWS）",
      "sourceUrl": "https://www.weather.gov/documentation/services-web-alerts",
      "endpoint": "https://api.weather.gov/alerts/active.atom",
      "format": "atom",
      "query": { "area": "{region}" },
      "filters": [
        { "key": "region", "label": "海域", "options": [
          { "value": "AN", "label": "美国大西洋沿岸" },
          { "value": "PZ", "label": "美国太平洋沿岸" },
          { "value": "GM", "label": "墨西哥湾沿岸" }
        ]}
      ],
      "cacheSeconds": 30,
      "limit": 100
    },
    {
      "id": "noaa-port-levels",
      "category": "logistics",
      "title": "港口潮位实测（近 72 小时）",
      "publisher": "NOAA CO-OPS",
      "sourceUrl": "https://api.tidesandcurrents.noaa.gov/api/dev/",
      "endpoint": "https://api.tidesandcurrents.noaa.gov/api/prod/datagetter",
      "format": "csv",
      "query": {
        "date": "recent", "station": "{station}", "product": "water_level", "datum": "MLLW",
        "time_zone": "gmt", "units": "metric", "format": "csv", "application": "CloudWorkbench"
      },
      "filters": [
        { "key": "station", "label": "港口测站", "options": [
          { "value": "8518750", "label": "纽约 Battery" },
          { "value": "9410660", "label": "洛杉矶" }
        ]}
      ],
      "dateField": "observed",
      "fields": [
        { "key": "observed", "label": "观测时间（UTC）", "path": "Date Time", "format": "utc-minute" },
        { "key": "level", "label": "潮位（米，MLLW）", "path": "Water Level" },
        { "key": "quality", "label": "质量标记", "path": "Quality" }
      ],
      "cacheSeconds": 60,
      "limit": 100,
      "exportLimit": 1000
    },
    {
      "id": "github-project-search",
      "title": "公开开源项目搜索",
      "publisher": "GitHub",
      "sourceUrl": "https://docs.github.com/en/rest/search/search#search-repositories",
      "endpoint": "https://api.github.com/search/repositories",
      "query": { "q": "{keyword}", "per_page": "10" },
      "filters": [{ "key": "keyword", "label": "项目关键词", "type": "text", "maxLength": 80 }],
      "rows": "items",
      "fields": [
        { "key": "project", "label": "项目", "path": "full_name" },
        { "key": "summary", "label": "项目简介", "path": "description" },
        { "key": "updated", "label": "更新时间", "path": "updated_at" }
      ],
      "limit": 10
    }
  ]
}
